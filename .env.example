# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env (đã gitignore).
# Khi deploy trên AgentBase Runtime, GREENNODE_CLIENT_ID/SECRET/AGENT_IDENTITY
# được nền tảng tự inject — ĐỪNG set ở đây. Local dev thì dùng .greennode.json.

# --- LLM (GreenNode MaaS, OpenAI-compatible) — lấy key qua /agentbase-llm ---
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3-5-27b

# --- AgentBase Memory (tạo qua /agentbase-memory) ---
MEMORY_ID=

# --- Notion (4 database) ---
NOTION_TOKEN=
NOTION_DB_TASKS=
NOTION_DB_SPRINTS=
NOTION_DB_MILESTONES=
NOTION_DB_RISKS=

# --- Bridge openzca (chạy trên máy bạn, xem bridge/README.md) ---
AGENT_ENDPOINT_URL=
# BOT_PREFIXES=mạnh,/manh,manh
# BOT_USER_ID=
# BRIDGE_PORT=3000

# --- Fallback model env (cũ; LLM_* ở trên được ưu tiên) ---
# MAAS_BASE_URL=https://maas.greennode.ai/v1
# MAAS_API_KEY=
